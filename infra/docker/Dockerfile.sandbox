# syntax=docker/dockerfile:1.7
# The sandbox: runs model-written code. Holds no secrets but its own token and the egress
# proxy credential, mounts only the workspaces volume, and sits on an internal network
# with no route out except through the egress proxy (same image, `python -m
# sandbox.egress`), which refuses private and LAN addresses. See compose.yaml.

FROM python:3.12-slim-bookworm AS build
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /srv/sandbox
COPY services/sandbox/pyproject.toml services/sandbox/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
COPY services/sandbox/sandbox ./sandbox
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

FROM python:3.12-slim-bookworm
# The everyday command-line toolbox. The root filesystem is read-only at run time, so
# this list is what `apt` would otherwise be for.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bubblewrap procps ca-certificates git curl wget less file tree bc \
        zip unzip xz-utils p7zip-full jq sqlite3 \
        ffmpeg imagemagick poppler-utils ghostscript pandoc \
        build-essential pkg-config nodejs npm \
        fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
COPY services/sandbox/runtime-requirements.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/runtime-requirements.txt && rm /tmp/runtime-requirements.txt
# Same uid as the api/worker, so both sides can read and write the shared workspaces.
# Nothing else is shared between the containers.
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app app \
    && mkdir -p /workspaces && chown app:app /workspaces
COPY --from=build --chown=root:root /srv/sandbox /srv/sandbox
ENV PATH="/usr/local/bin:/usr/bin:/bin" PYTHONUNBUFFERED=1 \
    SANDBOX_WORKSPACES=/workspaces SANDBOX_SCRATCH=/tmp/celius-sandbox SANDBOX_IN_CONTAINER=1 \
    MPLCONFIGDIR=/tmp/mpl
USER app
WORKDIR /srv/sandbox
EXPOSE 8100
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/srv/sandbox/.venv/bin/python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8100/v1/health', timeout=2).status == 200 else 1)"]
CMD ["/srv/sandbox/.venv/bin/python", "-m", "sandbox.app"]
