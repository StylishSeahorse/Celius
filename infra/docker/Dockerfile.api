# syntax=docker/dockerfile:1.7
# One image for the API and the worker. The web app is built here and served by the API.

FROM node:22-slim AS web
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter @celius/web
COPY apps/web/ apps/web/
RUN pnpm --filter @celius/web build

FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /srv/api
COPY services/api/pyproject.toml services/api/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
COPY services/api/ ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

FROM python:3.12-slim
RUN groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app app \
    && mkdir -p /data/app /data/workspaces && chown -R app:app /data
WORKDIR /srv/api
COPY --from=build --chown=app:app /srv/api /srv/api
COPY --from=web --chown=app:app /src/apps/web/dist /srv/web
ENV PATH="/srv/api/.venv/bin:$PATH" PYTHONUNBUFFERED=1 STATIC_ROOT=/srv/web
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health/live', timeout=2).status == 200 else 1)"
# Bounded graceful shutdown: open SSE streams would otherwise hold a restart until every
# in-progress reply finishes. Clients reconnect and resume from their last event id.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", \
     "--forwarded-allow-ips", "*", "--timeout-graceful-shutdown", "5"]
