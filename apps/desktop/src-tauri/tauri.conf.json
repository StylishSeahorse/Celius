{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celius",
  "version": "0.1.0",
  "identifier": "dev.celius.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Celius",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Self-hosted AI workspace",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
