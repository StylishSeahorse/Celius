# Copy to .env and fill in. Values are starting examples, not tuned production limits.
# Never commit .env. Secrets here are read only by the server; none reach the clients.

# --- Application ---
APP_ENV=production
APP_PUBLIC_URL=https://YOUR_APP_DOMAIN
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
APP_SINGLE_USER_MODE=true
APP_SESSION_TTL_HOURS=336

# First account, created only when the database has no users. Remove after first start.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD

# --- Database (compose builds DATABASE_URL from these; use URL-safe characters) ---
POSTGRES_USER=celius
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=celius

# --- API exposure (the reverse proxy forwards to this address) ---
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# --- Model server (llama.cpp on the RTX 3060 machine; keep it on the private network) ---
MODEL_PROVIDER=llama_cpp
MODEL_BASE_URL=http://MODEL_SERVER_HOST:8080/v1
# Leave empty only if llama-server runs without --api-key.
MODEL_API_KEY=
MODEL_DEFAULT_ID=local-model
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=300
MODEL_MAX_RETRIES=1
# Leave empty to use what the server reports via /props.
MODEL_DEFAULT_CONTEXT_TOKENS=
MODEL_MAX_OUTPUT_TOKENS=
MODEL_PARALLEL_REQUESTS=1
# Requires llama-server started with --jinja and a tool-capable template; verify with
# POST /api/v1/models/{id}/verify-tools before relying on it.
MODEL_ENABLE_TOOL_CALLING=true
MODEL_ENABLE_VISION=false
MODEL_ENABLE_EMBEDDINGS=false

# --- Chat and runs ---
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant."
# Tokens kept free below the model's context size, on top of the reserved output tokens.
CONTEXT_SAFETY_MARGIN_TOKENS=256
# A run whose worker stops renewing its lease for this long is requeued.
RUN_LEASE_SECONDS=30
RUN_MAX_ATTEMPTS=2

# --- Storage and limits ---
STORAGE_ROOT=/data/app
WORKSPACE_ROOT=/data/workspaces
MAX_UPLOAD_BYTES=52428800
MAX_USER_STORAGE_BYTES=10737418240

# --- Memory (phase 6) ---
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACTION=true
MEMORY_REQUIRE_REVIEW=true

# --- Tools (phase 5; no tools execute until the sandbox is validated) ---
TOOL_DEFAULT_PROFILE=read_only
TOOL_SANDBOX_REQUIRED=true
TOOL_DEFAULT_NETWORK_ACCESS=false

# --- Backups (phase 7) ---
BACKUP_ROOT=/data/backups
BACKUP_RETENTION_DAYS=30
