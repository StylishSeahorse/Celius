# Copy to .env and fill in. Values are starting examples, not tuned production limits.
# Never commit .env. Secrets here are read only by the server; none reach the clients.

# --- Application ---
APP_ENV=production
APP_PUBLIC_URL=https://YOUR_APP_DOMAIN
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
APP_SINGLE_USER_MODE=true
APP_SESSION_TTL_HOURS=336

# First account, created only when the database has no users. Remove after first start.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD

# --- Database (compose builds DATABASE_URL from these; use URL-safe characters) ---
POSTGRES_USER=celius
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=celius

# --- API exposure (the reverse proxy forwards to this address) ---
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

# --- Model server (llama.cpp on the RTX 3060 machine; keep it on the private network) ---
MODEL_PROVIDER=llama_cpp
MODEL_BASE_URL=http://MODEL_SERVER_HOST:8080/v1
# Leave empty only if llama-server runs without --api-key.
MODEL_API_KEY=
MODEL_DEFAULT_ID=local-model
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_READ_TIMEOUT_SECONDS=300
MODEL_MAX_RETRIES=1
# Leave empty to use what the server reports via /props.
MODEL_DEFAULT_CONTEXT_TOKENS=
MODEL_MAX_OUTPUT_TOKENS=
MODEL_PARALLEL_REQUESTS=1
# Requires llama-server started with --jinja and a tool-capable template; verify with
# POST /api/v1/models/{id}/verify-tools before relying on it.
MODEL_ENABLE_TOOL_CALLING=true
# Vision is detected from llama-server (/props); this is only the fallback. Images need a
# multimodal model started with --mmproj. The thinking on/off switch needs --jinja.
MODEL_ENABLE_VISION=false
MODEL_ENABLE_EMBEDDINGS=false

# --- Chat and runs ---
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant."
# Tokens kept free below the model's context size, on top of the reserved output tokens.
CONTEXT_SAFETY_MARGIN_TOKENS=256
# A run whose worker stops renewing its lease for this long is requeued.
RUN_LEASE_SECONDS=30
RUN_MAX_ATTEMPTS=2
# Streamed-token events of finished replies are deleted after this long (the reply is kept).
RUN_DELTA_RETENTION_MINUTES=10

# --- Storage and limits ---
STORAGE_ROOT=/data/app
WORKSPACE_ROOT=/data/workspaces
MAX_UPLOAD_BYTES=52428800
# Audio and video files (mp3, m4a, wav, flac, ogg, mp4, mov, webm, mkv, …): 2 GB.
MAX_MEDIA_UPLOAD_BYTES=2147483648
MAX_USER_STORAGE_BYTES=10737418240

# --- Files (phase 4) ---
UPLOAD_SESSION_TTL_MINUTES=60
# Characters of extracted text kept per file, and how much of one file goes into a prompt.
MAX_EXTRACTED_TEXT_CHARS=500000
MAX_ATTACHMENT_PROMPT_CHARS=60000
# Share of the context window that project knowledge files may use (0–0.9).
PROJECT_FILES_CONTEXT_SHARE=0.3
# Archives (.zip, and .docx/.xlsx/.pptx, which are zips): rejected beyond these.
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_TOTAL_BYTES=1073741824
ARCHIVE_MAX_RATIO=100
# Optional malware scanning with ClamAV (clamd). Leave empty to disable.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Background jobs (text extraction, exports) running at once in the worker.
JOB_PARALLEL=2

# --- Memory (phase 6, docs/adr/0009-memory-and-recall.md) ---
# Defaults for each user; they can change their own under Memory → Settings.
MEMORY_ENABLED=true
# After each reply, ask the model for lasting facts worth remembering (a short extra call).
MEMORY_AUTO_EXTRACTION=true
# Suggested memories wait for your approval.
MEMORY_REQUIRE_REVIEW=true
# Optional embeddings for recall by meaning (keyword search works without them). Set
# MODEL_ENABLE_EMBEDDINGS=true and point this at an OpenAI-compatible /v1 endpoint, e.g. a
# second llama-server: llama-server -m nomic-embed-text-v1.5.Q8_0.gguf --embeddings --port 8081
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Memories marked "always use" reach every chat; others only when relevant to the
# message: at most this many, close in meaning (with embeddings) or sharing its words.
MEMORY_PROMPT_MAX_ITEMS=8
MEMORY_MIN_SIMILARITY=0.55
MEMORY_RECALL_CHUNKS=4
MEMORY_CONTEXT_SHARE=0.15

# --- Tools (phase 5, docs/adr/0008-sandbox-and-tools.md) ---
# Profile for conversations that don't choose one: read_only | standard | developer |
# administrator. "standard" asks before anything that writes, runs code or uses the web.
TOOL_DEFAULT_PROFILE=standard
# The sandbox service from compose.yaml. Without it, code/shell/Git/document tools are off.
SANDBOX_URL=http://sandbox:8100
# Shared secret between the worker and the sandbox. Generate with: openssl rand -hex 32
SANDBOX_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Internet for code in the sandbox, through the egress proxy container: public addresses
# on ports 80/443 only, never your LAN. false = no network in the sandbox at all.
TOOL_SANDBOX_NETWORK=true
# Credential between the sandbox and the egress proxy. Generate with: openssl rand -hex 32
SANDBOX_EGRESS_TOKEN=REPLACE_WITH_RANDOM_EGRESS_TOKEN
# Web access (web_fetch, git_clone) goes out from the worker; private/LAN addresses are
# always refused. Optionally restrict to these host suffixes (comma-separated).
TOOL_NETWORK_ENABLED=true
TOOL_WEB_ALLOWLIST=
TOOL_WEB_MAX_BYTES=5242880
# Loop limits per reply.
TOOL_MAX_ITERATIONS=25
TOOL_MAX_RUN_SECONDS=900
TOOL_CALL_TIMEOUT_SECONDS=120
TOOL_MEMORY_MB=1024
TOOL_MAX_RESULT_CHARS=20000
# Unanswered approval requests expire, and the model is told the call was not run.
TOOL_APPROVAL_TTL_MINUTES=60
MCP_TIMEOUT_SECONDS=30
SCHEDULE_MIN_INTERVAL_MINUTES=15
SCHEDULE_MAX_PER_USER=20

# --- Backups (docs/operations/backup-restore.md) ---
# Host directory the backup script writes to (relative to infra/ or absolute).
BACKUP_DIR=../backups
# Archives are encrypted with this passphrase (AES-256, PBKDF2). Keep a copy somewhere
# other than this machine: without it a backup cannot be restored.
BACKUP_PASSPHRASE=REPLACE_WITH_LONG_BACKUP_PASSPHRASE
BACKUP_RETENTION_DAYS=30
# Include the tool workspaces (files the model created in its sandbox).
BACKUP_INCLUDE_WORKSPACES=true
# Off-host copy after each backup: an rsync target (user@nas:/backups/celius) or
# rclone:<remote>:<path>. Empty = local only (the status page warns about this).
BACKUP_OFFSITE_TARGET=

# --- Monitoring (docs/operations/monitoring.md) ---
# Problems are posted here when a check changes state: a Home Assistant webhook, an ntfy
# topic URL (with ALERT_WEBHOOK_FORMAT=ntfy), or anything that accepts JSON.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=json
ALERT_REPEAT_HOURS=6
ALERT_DISK_WARNING_PERCENT=15
ALERT_DISK_CRITICAL_PERCENT=5
ALERT_BACKUP_WARNING_HOURS=26
ALERT_BACKUP_CRITICAL_HOURS=72
# Bearer token for Prometheus scraping /api/v1/metrics (disabled when empty).
METRICS_TOKEN=

# --- Notifications and previews (docs/deployment/clients.md) ---
# Web Push to devices that turned notifications on (keys derive from APP_SECRET_KEY).
PUSH_ENABLED=true
# VAPID contact for the push services, e.g. mailto:you@example.com (default: APP_PUBLIC_URL).
PUSH_CONTACT=
# Preview images for PDFs (first page) and Office files.
FILE_PREVIEWS=true
# Duration and codecs of audio and video, and a still frame of videos (ffprobe/ffmpeg).
MEDIA_PROBE=true

# --- Long attachments ---
# The newest message's attachments may use this share of the model's context window.
# Longer documents are sent as their beginning plus the passages most relevant to the
# question; with tools on, the model can read the rest (attachments/<name>.txt).
ATTACHMENT_CONTEXT_SHARE=0.4
# Excerpt kept from files attached to earlier messages.
ATTACHMENT_HISTORY_CHARS=3000
# Earlier replies are replayed with a summary of the tools they used, with this much of
# each result (0 = off).
TOOL_HISTORY_RESULT_CHARS=400
